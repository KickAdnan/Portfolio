---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const posts = (await getCollection('writing')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const pageEntry = await getEntry('writing-page', 'writing-page');
const page = pageEntry?.data;
const heading = page?.heading ?? 'Writing & Thoughts.';
const description = page?.description ?? '';

const tagColors: Record<string, string> = {
  amber: 'text-amber-700 bg-amber-50/80 border-amber-200/40',
  purple: 'text-purple-700 bg-purple-50/80 border-purple-200/40',
  sky: 'text-sky-700 bg-sky-50/80 border-sky-200/40',
  emerald: 'text-emerald-700 bg-emerald-50/80 border-emerald-200/40',
};

const fmtDate = (date: Date) =>
  date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
---
<Base title="Writing — Adnan F. Muhammad">
  <main class="w-full max-w-[880px] my-auto pt-4 pb-24">
    <section class="w-full bg-white rounded-[36px] card-shadow border border-white/60 p-8 sm:p-12 md:p-14 relative overflow-hidden">
      <div class="max-w-2xl mb-8">
        <h1 class="text-2xl sm:text-3xl md:text-[32px] font-bold text-neutral-950 tracking-tight leading-tight">{heading}</h1>
        <p class="mt-2.5 text-neutral-500 text-sm sm:text-base leading-relaxed">{description}</p>
      </div>
      <div class="flex flex-wrap items-center gap-2 pb-6 border-b border-neutral-100">
        <button type="button" class="px-3.5 py-1.5 rounded-full text-xs font-semibold bg-neutral-900 text-white transition-all shadow-sm">All</button>
        <button type="button" onclick="toast('Filtering by category coming soon')" class="px-3.5 py-1.5 rounded-full text-xs font-medium text-neutral-600 bg-neutral-100 hover:bg-neutral-200/80 hover:text-neutral-900 transition-colors">Design Systems</button>
        <button type="button" onclick="toast('Filtering by category coming soon')" class="px-3.5 py-1.5 rounded-full text-xs font-medium text-neutral-600 bg-neutral-100 hover:bg-neutral-200/80 hover:text-neutral-900 transition-colors">AI &amp; Interaction</button>
        <button type="button" onclick="toast('Filtering by category coming soon')" class="px-3.5 py-1.5 rounded-full text-xs font-medium text-neutral-600 bg-neutral-100 hover:bg-neutral-200/80 hover:text-neutral-900 transition-colors">Product Strategy</button>
        <button type="button" onclick="toast('Filtering by category coming soon')" class="px-3.5 py-1.5 rounded-full text-xs font-medium text-neutral-600 bg-neutral-100 hover:bg-neutral-200/80 hover:text-neutral-900 transition-colors">Case Studies</button>
      </div>
      <div class="divide-y divide-neutral-100">
        {posts.map((post) => (
          <a
            href={`/writing/${post.id}`}
            class="group block py-6 transition-all duration-200 hover:bg-neutral-50/70 -mx-4 px-4 sm:-mx-6 sm:px-6 rounded-2xl cursor-pointer"
          >
            <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-1.5">
              <span class="text-xs font-medium text-neutral-400 tracking-wide uppercase">{fmtDate(post.data.date)} · {post.data.readTime}</span>
              <div class="flex items-center space-x-2">
                {post.data.tags.map((tag, i) => (
                  <span class={`text-[11px] font-medium px-2 py-0.5 rounded-md ${i === 0 ? `border ${tagColors[post.data.tagColor]}` : 'text-neutral-600 bg-neutral-100'}`}>{tag}</span>
                ))}
              </div>
            </div>
            <div class="flex items-start justify-between gap-4">
              <div>
                <h2 class="text-base sm:text-lg font-semibold text-neutral-900 group-hover:text-amber-900 transition-colors tracking-tight">{post.data.title}</h2>
                {post.data.description && (
                  <p class="mt-1 text-xs sm:text-sm text-neutral-500 leading-relaxed max-w-2xl">{post.data.description}</p>
                )}
              </div>
              <div class="pt-1 text-neutral-300 group-hover:text-neutral-900 group-hover:translate-x-1 transition-all flex-shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"></path></svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
