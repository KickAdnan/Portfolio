---
import { getCollection, getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import AboutCard from '../components/AboutCard.astro';
import WorkCard from '../components/WorkCard.astro';

const works = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const pageEntry = await getEntry('works-page', 'works-page');
const page = pageEntry?.data;
const headline = page?.headline ?? '';
const description = page?.description ?? '';
const ctaTitle = page?.ctaTitle ?? '';
const ctaSubtitle = page?.ctaSubtitle ?? '';
---
<Base title="Adnan F. Muhammad — Works">
  <main class="w-full max-w-[880px] my-auto pt-4 pb-24">
    <AboutCard active="works">
      <div class="flex flex-col space-y-8">
        <div class="flex flex-col space-y-4 pb-6 border-b border-neutral-200/60">
          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-5 pt-1">
            <div>
              <h1 class="text-2xl sm:text-[28px] font-bold tracking-tight text-neutral-900 leading-snug whitespace-pre-line">{headline}</h1>
              <p class="text-[13.5px] sm:text-[14px] text-neutral-500 mt-2 max-w-xl leading-relaxed">{description}</p>
            </div>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {works.map((work) => <WorkCard work={work} />)}
        </div>

        <div class="flex flex-col sm:flex-row justify-between items-center p-5 rounded-2xl bg-neutral-900 text-white mt-8 border border-neutral-800 gap-4">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-full bg-emerald-500/20 text-emerald-400 flex items-center justify-center flex-shrink-0">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
            </div>
            <div>
              <p class="text-[13px] font-semibold text-white">{ctaTitle}</p>
              <p class="text-[12px] text-neutral-400">{ctaSubtitle}</p>
            </div>
          </div>
          <a
            href="/contacts"
            class="px-4 py-2 rounded-full bg-white text-neutral-950 font-medium text-[12.5px] hover:bg-neutral-100 transition-colors whitespace-nowrap shadow-sm self-stretch sm:self-auto text-center cursor-pointer"
          >Start a conversation →</a>
        </div>
      </div>
    </AboutCard>
  </main>
</Base>
